{
  "name": "pi-memorix",
  "version": "0.1.8",
  "description": "Pi extension that bridges Memorix memory hooks into Pi's session lifecycle",
  "type": "module",
  "main": "memorix.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "memorix",
    "memory",
    "ai-memory",
    "session",
    "context",
    "hooks",
    "lifecycle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anh-chu/pi-memorix.git"
  },
  "homepage": "https://github.com/anh-chu/pi-memorix#readme",
  "bugs": {
    "url": "https://github.com/anh-chu/pi-memorix/issues"
  },
  "files": [
    "memorix.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./memorix.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@marcfargas/pi-test-harness": "^0.5.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "overrides": {
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@*",
    "@mariozechner/pi-ai": "npm:@earendil-works/pi-ai@*",
    "@mariozechner/pi-agent-core": "npm:@earendil-works/pi-agent-core@*"
  }
}
